<%- include('partials/head', { title: 'New Recipe' }) %>

<section class="edit-recipe-container">
  <h1>Add New Recipe</h1>
  <form action="/recipes" method="post" enctype="multipart/form-data">
    <fieldset>
      <legend>Basic Info</legend>
      <div class="form-group">
        <label for="title">Title</label><br/>
        <input type="text" id="title" name="title" required />
      </div>
      <div class="form-group">
        <label for="prep_time">Prep Time</label><br/>
        <input type="text" id="prep_time" name="prep_time" placeholder="e.g. 20 mins" />
      </div>
    </fieldset>

    <fieldset>
      <legend>Ingredients (one per line)</legend>
      <div class="form-group">
        <textarea id="ingredients" name="ingredients" rows="5" required></textarea>
      </div>
    </fieldset>

    <fieldset>
      <legend>Steps (separate paragraphs)</legend>
      <div class="form-group">
        <textarea id="steps" name="steps" rows="6" required></textarea>
      </div>
    </fieldset>

    <fieldset>
      <legend>Image</legend>
      <div class="form-group">
        <label for="image">Upload Photo</label><br/>
        <input type="file" id="image" name="image" accept="image/*" />
      </div>
    </fieldset>

    <div class="form-actions">
      <button type="submit">Save Recipe</button>
      <a href="/recipes" class="button">Cancel</a>
    </div>
  </form>
</section>

<%- include('partials/footer') %>
