<%- include('partials/head', { title: 'Review Event' }) %>

<section class="edit-recipe-container">
  <h1>Review & Confirm Event</h1>
  <img src="<%= image_url %>" alt="Uploaded schedule" class="recipe-detail-image" />

  <form action="/events" method="post">
    <input type="hidden" name="image_url" value="<%= image_url %>" />

    <fieldset>
      <legend>Basic Info</legend>
      <div class="form-group">
        <label for="title">Title</label><br/>
        <input type="text" id="title" name="title" value="<%= title %>" required />
      </div>
      <div class="form-group">
        <label for="event_date">Date</label><br/>
        <input type="date" id="event_date" name="event_date" value="<%= event_date %>" required />
      </div>
      <div class="form-group">
        <label for="event_time">Time</label><br/>
        <input type="time" id="event_time" name="event_time" value="<%= event_time %>" />
      </div>
      <div class="form-group">
        <label for="location">Location</label><br/>
        <input type="text" id="location" name="location" value="<%= location %>" />
      </div>
    </fieldset>

    <fieldset>
      <legend>Description / Notes</legend>
      <div class="form-group">
        <textarea id="description" name="description" rows="6"><%= description %></textarea>
      </div>
    </fieldset>

    <div class="form-actions">
      <button type="submit">Save Event</button>
      <a href="/events"><button type="button">Cancel</button></a>
    </div>
  </form>
</section>

<%- include('partials/footer') %>
