<%- include('partials/head', { title: 'Recipes' }) %>

<h1>Recipes</h1>
<a href="/recipes/new" class="button">Add New Recipe</a>

<% if (!recipes.length) { %>
  <p>No recipes yet.</p>
<% } else { %>
  <div class="recipe-grid">
    <% recipes.forEach(r => { %>
      <div class="recipe-card">
        <% if (r.image_url) { %>
          <img src="<%= r.image_url %>" alt="<%= r.title %>" />
        <% } %>
        <div class="recipe-card-content">
          <h2><a href="/recipes/<%= r.id %>"><%= r.title %></a></h2>
          <% if (r.prep_time) { %>
            <p class="meta"><%= r.prep_time %></p>
          <% } %>
        </div>
        <div class="recipe-card-actions">
          <a href="/recipes/<%= r.id %>">View</a>
          <a href="/recipes/<%= r.id %>/edit">Edit</a>
          <form action="/recipes/<%= r.id %>/delete" method="post" onsubmit="return confirm('Delete recipe?');">
            <button type="submit">Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
