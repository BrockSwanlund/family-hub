<%- include('../partials/head', { title: 'Admin: Manage Events' }) %>

<h1>Manage Events</h1>
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Title</th>
      <th>Date</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% events.forEach(ev => { %>
      <tr>
        <td><%= ev.id %></td>
        <td><%= ev.title %></td>
        <td><%= ev.event_date %> <%= ev.event_time || '' %></td>
        <td>
          <form action="/admin/events/<%= ev.id %>/delete" method="post" onsubmit="return confirm('Delete this event?');">
            <button type="submit">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>
